{
  "name": "@project-orion/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && vite build --ssr scripts/prerender.tsx --target esnext --outDir .prerender && node .prerender/prerender.js",
    "start": "node server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.132.0",
    "lucide-react": "^0.564.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.7.3",
    "vite": "^6.4.0"
  }
}
