DATABASE_URL=
REDIS_URL=

AGENT_JWT_SECRET=
USER_JWT_SECRET=

# Lifetime of short-lived agent access tokens (seconds). Agents auto-refresh
# from their durable enrollment token, so this can be kept short.
AGENT_ACCESS_TTL_SEC=900

HTTP_PORT=4000
GRPC_PORT=50052
# Comma-separated allowlist in production; avoid "*" once clients are known.
CORS_ORIGIN=*

# ── Horizontal scaling ──────────────────────────────────────────────────────
# Schema is owned by migrations (npm run migration:run). Only enable synchronize
# for a throwaway single-instance database — never with multiple instances.
DB_SYNCHRONIZE=false
# Per-instance DB connection pool cap (replicas * DB_POOL_MAX <= Postgres max).
DB_POOL_MAX=10
# Redis backs the WS adapter, ingest dedup, revocation and the scheduler lock.
# Set true so the app refuses to boot without REDIS_URL when running >1 instance.
REQUIRE_REDIS=false
# Coalesce dashboard.update broadcasts per device to at most one per N ms.
DASHBOARD_EMIT_THROTTLE_MS=2000
