# Ingestion endpoint (TLS-terminating reverse proxy). Use host:443 in prod.
AGENT_SERVER_ADDRESS=localhost:443
AGENT_DEVICE_ID=my-device

# Durable enrollment token returned when the device is created. The agent
# exchanges it for short-lived access tokens automatically — set once, never
# needs changing even after long downtime.
AGENT_ENROLLMENT_TOKEN=replace-with-enrollment-token

# ── TLS ───────────────────────────────────────────────────────────────────
# For local testing against a self-signed proxy (e.g. Caddy `tls internal`):
AGENT_TLS_INSECURE_SKIP_VERIFY=true
# In production omit the above and, if using a private CA, trust it explicitly:
# AGENT_TLS_CA_FILE=/etc/orion/ca.pem

# ── Store-and-forward buffer ──────────────────────────────────────────────
# Put this on a persistent volume so buffered telemetry survives agent restarts.
AGENT_WAL_PATH=orion-agent.wal
AGENT_WAL_MAX_BATCHES=10000

AGENT_INTERVAL_SEC=5
