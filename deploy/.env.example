# Public addresses served by your own reverse proxy. Use the dashboard's exact
# HTTPS origin for CORS and passkeys (no trailing slash). Route both API/WS and
# gRPC from the API hostname; the gRPC route needs HTTP/2 to its upstream.
SCOPE_WEB_ORIGIN=https://app.scope.example.com
SCOPE_API_URL=https://api.scope.example.com
SCOPE_AGENT_GRPC_ADDRESS=api.scope.example.com:443
SCOPE_AGENT_TLS_DISABLE=false

# Bind only to the local host by default. If your proxy runs on another host,
# use a private interface address and restrict access with a firewall.
SCOPE_BIND_ADDRESS=127.0.0.1
SCOPE_WEB_PORT=3000
SCOPE_API_PORT=4000
SCOPE_GRPC_PORT=50052
SCOPE_LANDING_PORT=8080

# "main" tracks the latest successful main-branch image build. Pin a release
# tag or digest for a deployment that must not change until you choose to update.
SCOPE_IMAGE_TAG=main

# Fill all secrets before running Compose. Use long random hex strings. The
# database password is interpolated into a URL, so URL-reserved characters must
# be encoded; hex avoids this issue.
POSTGRES_PASSWORD=
AGENT_JWT_SECRET=
USER_JWT_SECRET=
MFA_ENCRYPTION_SECRET=

# Optional email notifications. Supply an SMTP relay and sender address, then
# add recipients and enable Email on the dashboard's Notifications page.
# Port 587 uses STARTTLS by default; for port 465 set SECURE=true.
SCOPE_SMTP_HOST=
SCOPE_SMTP_PORT=587
SCOPE_SMTP_USER=
SCOPE_SMTP_PASSWORD=
SCOPE_SMTP_FROM=
SCOPE_SMTP_SECURE=false
SCOPE_SMTP_REQUIRE_TLS=true
