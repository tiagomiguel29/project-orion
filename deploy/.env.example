# Choose three DNS names pointing to this host. Open ports 80 and 443.
SCOPE_LANDING_DOMAIN=www.scope.example.com
SCOPE_WEB_DOMAIN=app.scope.example.com
SCOPE_API_DOMAIN=api.scope.example.com

# "main" tracks the latest successful main-branch image build. Pin a release
# tag or digest for a deployment that must not change until you choose to update.
SCOPE_IMAGE_TAG=main

# Fill all secrets before running Compose. Use long random hex strings. The
# database password is interpolated into a URL, so URL-reserved characters must
# be encoded; hex avoids this issue.
POSTGRES_PASSWORD=
AGENT_JWT_SECRET=
USER_JWT_SECRET=
MFA_ENCRYPTION_SECRET=
